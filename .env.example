# MatchSieve configuration template. Copy to .env and edit locally.
# This example intentionally contains NO real API keys. Never commit .env.

MATCHSIEVE_DB_PATH=data/matchsieve.sqlite3
MATCHSIEVE_HOST=127.0.0.1
MATCHSIEVE_PORT=8765
MATCHSIEVE_ENABLED_PROVIDERS=
MATCHSIEVE_REQUEST_TIMEOUT=12

# Optional local Ollama commentary. No cloud API key is used by this integration.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=90

# Provider credentials. Leave blank until the specific provider is licensed,
# enabled and live-tested. Only explicitly enabled providers may make network calls.
SPORTMONKS_API_TOKEN=
FOOTBALL_DATA_ORG_TOKEN=
FOOTBALLDATA_IO_API_KEY=
LIVEFOOTBALL_API_KEY=
SPORTSCORE_API_KEY=
CLEARSPORTS_API_KEY=
THE_ODDS_API_KEY=
OPENWEATHER_API_KEY=

# Compatibility: MATCHSIEVE_* settings take precedence over legacy SENTINEL_* names.
# Original BojoSentinelAI config/key files are not included here; copy secrets privately.
